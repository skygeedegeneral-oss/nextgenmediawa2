  <a href="https://facebook.com/" target="_blank">Facebook</a>
  <a href="https://tiktok.com/" target="_blank">TikTok</a>
  <a href="https://youtube.com/" target="_blank">YouTube</a>
 </div>
 <p>© 2026 NextGenMediaWa. All rights reserved.</p>
</footer>

<script>
// WEBSITE STORAGE

const DB_KEY="nextgen_posts_v1";
const MUSIC_KEY="nextgen_music_v1";
const RECENT_KEY="nextgen_recent_v1";

function getData(key){
 try{return JSON.parse(localStorage.getItem(key))||[]}
 catch(e){return []}
}
function saveData(key,data){
 localStorage.setItem(key,JSON.stringify(data));
}

let posts=getData(DB_KEY);
let music=getData(MUSIC_KEY);

// SAMPLE ARTICLES

if(posts.length===0){
 posts=[
 {
 id:1,title:"Welcome to NextGenMediaWa",
 category:"Ghana News",
 author:"NextGenMediaWa",
 content:"Welcome to NextGenMediaWa, your trusted source for news, music, sports and entertainment. We inform, entertain and inspire.",
 image:"",
 date:new Date().toLocaleDateString(),
 breaking:false,
 views:0
 },
 {
 id:2,title:"Latest Ghana Entertainment Updates",
 category:"Entertainment",
 author:"NextGenMediaWa",
 content:"Follow NextGenMediaWa for the latest entertainment updates, celebrity news and music releases.",
 image:"",
 date:new Date().toLocaleDateString(),
 breaking:false,
 views:0
 },
 {
 id:3,title:"Football News and Updates",
 category:"Sports",
 author:"NextGenMediaWa",
 content:"Stay updated with football fixtures, results, transfers and sports discussions.",
 image:"",
 date:new Date().toLocaleDateString(),
 breaking:false,
 views:0
 }
 ];
 saveData(DB_KEY,posts);
}

// HTML SAFETY

function escapeHTML(value){
 return String(value||"").replace(/[&<>"']/g,c=>({
 "&":"&amp;","<":"&lt;",">":"&gt;",
 '"':"&quot;","'":"&#39;"
 })[c]);
}

// IMAGE PLACEHOLDER

function imageHTML(src){
 return src
 ? `<img src="${src}" alt="Article image">`
 : `<div style="height:165px;background:#222;color:white;display:grid;place-items:center;font-weight:bold">NextGenMediaWa</div>`;
}

// ARTICLE CARD

function articleCard(post){
 return `
 <article class="card">
 ${imageHTML(post.image)}
 <div class="card-content">
 <span class="category">${escapeHTML(post.category)}</span>
 <h3>${escapeHTML(post.title)}</h3>
 <p>${escapeHTML(post.content.slice(0,115))}...</p>
 <p style="margin-top:8px;font-size:11px">
 By ${escapeHTML(post.author)} | ${escapeHTML(post.date)}
 </p>
 <div class="card-actions">
 <button class="small-btn" onclick="readArticle(${post.id})">Read More</button>
 <button class="secondary-btn" onclick="shareArticle(${post.id})">Share</button>
 </div>
 </div>
 </article>`;
}

function renderPosts(){
 const groups={
 latestPosts:posts,
 ghanaPosts:posts.filter(p=>p.category==="Ghana News"),
 internationalPosts:posts.filter(p=>p.category==="International News"),
 entertainmentPosts:posts.filter(p=>["Entertainment","Celebrity News"].includes(p.category)),
 sportsPosts:posts.filter(p=>p.category==="Sports"),
 trendingPosts:posts.filter(p=>p.category==="Trending Topics"),
 lifestylePosts:posts.filter(p=>p.category==="Lifestyle")
 };

 Object.entries(groups).forEach(([id,list])=>{
 document.getElementById(id).innerHTML=list.length
 ?list.slice(0,12).map(articleCard).join("")
 :'<div class="empty">No articles published in this category yet.</div>';
 });

 const breaking=posts.find(p=>p.breaking);
 document.getElementById("breakingText").textContent=
 breaking?breaking.title:"Welcome to NextGenMediaWa. Stay informed with the latest updates.";

 renderRecent();
 renderPopular();
}

// SEARCH

function searchPosts(){
 const query=document.getElementById("searchInput").value.toLowerCase();
 const results=posts.filter(p=>
 (p.title+" "+p.category+" "+p.content+" "+p.author).toLowerCase().includes(query)
 );
 document.getElementById("latestPosts").innerHTML=query
 ?results.length?results.map(articleCard).join(""):'<div class="empty">No matching stories found.</div>'
 :posts.slice(0,12).map(articleCard).join("");
}

// READ ARTICLE

function readArticle(id){
 const post=posts.find(p=>p.id===id);
 if(!post)return;

 post.views=(post.views||0)+1;
 saveData(DB_KEY,posts);

 let recent=getData(RECENT_KEY).filter(x=>x!==id);
 recent.unshift(id);
 saveData(RECENT_KEY,recent.slice(0,5));

 document.getElementById("articleDetails").innerHTML=`
 <span class="category">${escapeHTML(post.category)}</span>
 <h2>${escapeHTML(post.title)}</h2>
 <p>By ${escapeHTML(post.author)} | ${escapeHTML(post.date)}</p>
 ${imageHTML(post.image)}
 <p style="white-space:pre-wrap">${escapeHTML(post.content)}</p>
 <button class="small-btn" onclick="shareArticle(${post.id})">Share Story</button>
 `;
 document.getElementById("articleModal").style.display="block";
 renderPopular();
 renderRecent();
}

function closeArticle(){
 document.getElementById("articleModal").style.display="none";
}

// SHARE ARTICLES

function shareArticle(id){
 const p=posts.find(x=>x.id===id);
 if(!p)return;
 const shareData={
 title:p.title,
 text:p.title+" - NextGenMediaWa",
 url:location.href
 };
 if(navigator.share){
 navigator.share(shareData).catch(()=>{});
 }else{
 navigator.clipboard?.writeText(shareData.text+" "+shareData.url)
 .then(()=>alert("Share text copied."));
 }
}

// RECENT STORIES

function renderRecent(){
 const ids=getData(RECENT_KEY);
 const recent=ids.map(id=>posts.find(p=>p.id===id)).filter(Boolean);
 document.getElementById("recentPosts").innerHTML=
 recent.length?recent.map(articleCard).join("")
 :'<div class="empty">Recently viewed articles will appear here.</div>';
}

// POPULAR STORIES

function renderPopular(){
 const popular=[...posts].sort((a,b)=>(b.views||0)-(a.views||0)).slice(0,5);
 document.getElementById("popularDownloads").innerHTML=
 popular.length?popular.map(p=>`
 <div class="music-item">
 <strong>${escapeHTML(p.title)}</strong>
 <p>${p.views||0} views</p>
 <button class="small-btn" onclick="readArticle(${p.id})">Read Story</button>
 </div>`).join("")
 :'<div class="empty">No popular stories yet.</div>';
}

// MUSIC DISPLAY

function renderMusic(){
 const list=document.getElementById("musicList");
 list.innerHTML=music.length?music.map((m,i)=>`
 <div class="music-item">
 <h3>${escapeHTML(m.title)}</h3>
 <p>Artist: ${escapeHTML(m.artist)}</p>
 ${m.cover?`<img src="${m.cover}" style="width:100%;max-height:180px;object-fit:cover;border-radius:5px;margin-top:10px">`:""}
 <audio controls preload="none" src="${m.file}"></audio>
 <a href="${m.file}" download="${escapeHTML(m.title)}.mp3">Download Music</a>
 </div>`).join("")
 :'<div class="empty">No music uploaded yet. New music will appear here.</div>';
}

// ADMIN LOGIN

let adminLoggedIn=false;

function openAdmin(){
 document.getElementById("adminPanel").style.display="block";
 document.getElementById("adminPanel").scrollIntoView({behavior:"smooth"});
}

function loginAdmin(){
 const password=document.getElementById("adminPassword").value;
 if(password==="change-me-123"){
 adminLoggedIn=true;
 document.getElementById("adminLogin").style.display="none";
 document.getElementById("adminTools").style.display="block";
 renderAdmin();
 }else{
 alert("Incorrect password.");
 }
}

function logoutAdmin(){
 adminLoggedIn=false;
 document.getElementById("adminLogin").style.display="block";
 document.getElementById("adminTools").style.display="none";
 document.getElementById("adminPassword").value="";
}

// FILE TO DATA URL

function readFile(file){
 return new Promise((resolve,reject)=>{
 if(!file){resolve("");return}
 const reader=new FileReader();
 reader.onload=()=>resolve(reader.result);
 reader.onerror=reject;
 reader.readAsDataURL(file);
 });
}

// PUBLISH ARTICLE

document.getElementById("postForm").addEventListener("submit",async function(e){
 e.preventDefault();
 if(!adminLoggedIn)return;

 const file=document.getElementById("postImage").files[0];
 if(file&&file.size>1.5*1024*1024){
 alert("Please use an image smaller than 1.5MB.");
 return;
 }

 const image=await readFile(file);

 const post={
 id:Date.now(),
 title:document.getElementById("postTitle").value.trim(),
 category:document.getElementById("postCategory").value,
 author:document.getElementById("postAuthor").value.trim()||"NextGenMediaWa",
 content:document.getElementById("postContent").value.trim(),
 image:image,
 date:new Date().toLocaleDateString(),
 breaking:document.getElementById("isBreaking").checked,
 views:0
 };

 posts.unshift(post);
 saveData(DB_KEY,posts);
 this.reset();
 renderPosts();
 renderAdmin();
 alert("Article published successfully in this browser.");
});

// UPLOAD MUSIC

document.getElementById("musicForm").addEventListener("submit",async function(e){
 e.preventDefault();
 if(!adminLoggedIn)return;

 const file=document.getElementById("songFile").files[0];
 const cover=document.getElementById("songCover").files[0];

 if(!file)return;

 if(file.size>5*1024*1024){
 alert("For this single-file version, use music files smaller than 5MB.");
 return;
 }

 if(cover&&cover.size>1.5*1024*1024){
 alert("Please use a cover image smaller than 1.5MB.");
 return;
 }

 const musicFile=await readFile(file);
 const coverImage=await readFile(cover);

 music.unshift({
 id:Date.now(),
 title:document.getElementById("songTitle").value.trim(),
 artist:document.getElementById("songArtist").value.trim(),
 file:musicFile,
 cover:coverImage,
 downloads:0
 });

 saveData(MUS
