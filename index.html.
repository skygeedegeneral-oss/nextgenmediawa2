<!-- ARTICLE READING MODAL -->

<div class="modal" id="articleModal">
 <div class="modal-content">
  <button class="close" onclick="closeArticle()">Close</button>
  <div id="articleDetails"></div>
 </div>
</div>

<footer>
 <h2>NextGen<span>MediaWa</span></h2>
 <p>WE INFORM, ENTERTAIN AND INSPIRE.</p>
