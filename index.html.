
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NextGenMediaWa | We Inform, Entertain and Inspire</title>
<meta name="description" content="NextGenMediaWa brings you Ghanaian and international news, music, sports and entertainment.">

<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--red:#ed1c24;--black:#111;--white:#fff;--grey:#f4f4f4}
body{font-family:Arial,sans-serif;background:var(--grey);color:#171717}
a{text-decoration:none;color:inherit}
button{cursor:pointer;border:0;font-weight:bold}
header{background:#111;color:white;padding:20px 5%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap}
.brand{font-size:27px;font-weight:bold}
.brand span,footer span{color:var(--red)}
.tagline{font-size:11px;color:#ddd;margin-top:6px;letter-spacing:1px}
.header-right{display:flex;gap:10px;align-items:center}
.admin-btn{background:var(--red);color:white;padding:10px 15px;border-radius:5px}
nav{background:var(--red);padding:14px 5%;display:flex;gap:22px;flex-wrap:wrap}
nav a{color:white;font-size:13px;font-weight:bold}
nav a:hover{color:#111}
.menu-btn{display:none;background:transparent;color:white;font-size:24px}
.breaking{background:#222;color:white;padding:12px 5%;font-size:13px}
.breaking strong{background:var(--red);padding:7px;margin-right:10px}
.hero{background:linear-gradient(120deg,#111,#292929);color:white;padding:65px 7%}
.hero h1{font-size:38px;margin-bottom:15px}
.hero h1 span{color:var(--red)}
.hero p{max-width:650px;line-height:1.8;color:#ddd}
.hero-btn{display:inline-block;background:var(--red);color:white;padding:12px 20px;margin-top:22px;border-radius:4px}
.search-area{padding:20px 5%;background:white}
.search-area input{width:100%;padding:14px;border:1px solid #ddd;border-radius:5px;font-size:15px}
.section{padding:35px 5%}
.section h2,.music h2{border-left:5px solid var(--red);padding-left:12px;margin-bottom:22px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px}
.card{background:white;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px #00000012}
.card img{width:100%;height:165px;object-fit:cover;background:#ddd}
.card-content{padding:18px}
.category{color:var(--red);font-size:11px;font-weight:bold;text-transform:uppercase}
.card h3{margin:9px 0;font-size:18px}
.card p{color:#666;font-size:14px;line-height:1.6}
.card-actions{display:flex;gap:10px;margin-top:15px;flex-wrap:wrap}
.small-btn{background:var(--red);color:white;padding:9px 12px;border-radius:4px;font-size:12px}
.secondary-btn{background:#222;color:white;padding:9px 12px;border-radius:4px;font-size:12px}
.music{padding:35px 5%;background:#eee}
.music-item{background:white;padding:17px;border-radius:7px;margin-bottom:13px}
.music-item h3{margin-bottom:7px}
.music-item audio{width:100%;margin:10px 0}
.music-item a{display:inline-block;background:var(--red);color:white;padding:9px 14px;border-radius:4px;font-size:13px}
.empty{background:white;padding:25px;text-align:center;color:#777;border-radius:6px}
footer{background:#111;color:white;text-align:center;padding:30px 15px;line-height:1.9;margin-top:20px}
footer p{font-size:13px;color:#ccc}
.social{display:flex;justify-content:center;gap:12px;margin:15px 0}
.social a{background:var(--red);padding:9px 15px;border-radius:4px;color:white;font-size:13px}
.modal{display:none;position:fixed;inset:0;background:#000b;z-index:1000;overflow:auto;padding:20px}
.modal-content{background:white;max-width:750px;margin:30px auto;padding:25px;border-radius:8px;position:relative}
.close{float:right;background:var(--red);color:white;padding:7px 12px;border-radius:4px}
.modal-content h2{margin:20px 0 12px}
.modal-content p{line-height:1.8;margin:12px 0}
.modal-content img{width:100%;max-height:350px;object-fit:cover;margin-top:15px}
.admin-panel{display:none;background:white;padding:25px 5%}
.admin-panel h2{margin-bottom:15px}
.admin-panel input,.admin-panel textarea,.admin-panel select{width:100%;padding:12px;margin:7px 0 15px;border:1px solid #ddd;border-radius:5px;font:inherit}
.admin-panel textarea{min-height:120px}
.admin-panel label{font-weight:bold;font-size:13px}
.admin-panel button{background:var(--red);color:white;padding:12px 17px;border-radius:4px;margin:5px 5px 5px 0}
.admin-panel .delete{background:#222}
.admin-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:25px}
hr{border:0;border-top:1px solid #ddd;margin:25px 0}
@media(max-width:650px){
 header{gap:15px}
 .brand{font-size:23px}
 .menu-btn{display:block}
 nav{display:none;flex-direction:column;gap:15px}
 nav.show{display:flex}
 .hero h1{font-size:30px}
 .section{padding:28px 4%}
 .cards{grid-template-columns:1fr}
 .header-right{width:100%;justify-content:space-between}
}
</style>
</head>

<body>

<header>
 <div>
  <div class="brand">NextGen<span>MediaWa</span></div>
